# ==========================================
# ScholarBeacon Backend Environment Config
# ==========================================
NODE_ENV=development
API_PORT=5000
API_HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/scholarpath
MONGODB_DB_NAME=scholarpath

# JWT Authentication
JWT_SECRET=super_secret_scholarpath_jwt_signing_key_32_chars_min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Email Configuration (Add your credentials here)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=ScholarBeacon <your-email@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ScholarBeacon <no-reply@scholarbeacon.org>
