{
  "name": "scholarpath-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ScholarPath Backend — Pure JavaScript (Node.js + Express + Mongoose + Automated Monitoring)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seeds/seed-official-scholarships.js",
    "worker": "node src/worker/monitor-scheduler.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "nodemailer": "^10.2.1",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
