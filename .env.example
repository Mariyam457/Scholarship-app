# ==========================================
# ScholarBeacon Backend Environment Config
# ==========================================
NODE_ENV=development
API_PORT=5000
API_HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/scholarpath
MONGODB_DB_NAME=scholarpath

# JWT Authentication
JWT_SECRET=super_secret_scholarpath_jwt_signing_key_32_chars_min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PASSWORD_SALT_ROUNDS=12

# Admin Bootstrap Credentials (auto-seeded on first run)
ADMIN_BOOTSTRAP_EMAIL=scholar@email.com
ADMIN_BOOTSTRAP_PASSWORD=scholar1234

# CORS & Allowed Origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX=50

# Worker & Monitoring Engine
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
SOURCE_CHECK_INTERVAL_MINUTES=1440
SOURCE_REQUEST_TIMEOUT_MS=30000
SOURCE_MAX_RESPONSE_SIZE_BYTES=10485760
USER_AGENT=ScholarPath-Bot/1.0 (+https://scholarpath.internal/bot; verification-research@scholarpath.internal)

# SMTP Email Configuration (for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ScholarBeacon <no-reply@scholarbeacon.org>

